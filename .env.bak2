# ArmServe Configuration & Secrets (.env)
ARMSERVE_APP__ENV=development
ARMSERVE_APP__DEBUG=true
ARMSERVE_APP__LOG_LEVEL=INFO
ARMSERVE_APP__API_HOST=0.0.0.0
ARMSERVE_APP__API_PORT=8000
ARMSERVE_APP__STORAGE_PATH=./storage

ARMSERVE_DATABASE__HOST=localhost
ARMSERVE_DATABASE__PORT=5432
ARMSERVE_DATABASE__USER=armserve
ARMSERVE_DATABASE__PASSWORD=armserve_dev_pass
ARMSERVE_DATABASE__NAME=armserve_dev

ARMSERVE_AUTH__SECRET_KEY=armserve-secure-jwt-signing-secret-key-32bytes-min
