# ArmServe Staging Environment Terraform Variables Example
aws_region             = "us-east-1"
project_name           = "armserve"
environment            = "staging"
vpc_cidr               = "10.20.0.0/16"
availability_zones     = ["us-east-1a", "us-east-1b", "us-east-1c"]
graviton_instance_type = "c6g.xlarge"
alert_email            = "staging-alerts@armserve.local"

tags = {
  Project     = "ArmServe"
  Environment = "staging"
  ManagedBy   = "Terraform"
  Repository  = "ArmInferX"
}
