# ==============================================================================
# ArmServe Configuration & Secrets Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local development.
# - DO NOT commit '.env' or any file containing actual secrets to source control.
# - All sensitive variables use SecretStr masking to prevent accidental exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Operating environment: 'development', 'test', 'staging', or 'production'
ARMSERVE_APP__ENV=development

# Debug mode: true for verbose local logs; MUST be false in production
ARMSERVE_APP__DEBUG=true

# Logging level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
ARMSERVE_APP__LOG_LEVEL=INFO

# API server binding host and port
ARMSERVE_APP__API_HOST=0.0.0.0
ARMSERVE_APP__API_PORT=8000

# Base directory for local model storage and cache
ARMSERVE_APP__STORAGE_PATH=./storage

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + TimescaleDB)
# ------------------------------------------------------------------------------
ARMSERVE_DATABASE__HOST=localhost
ARMSERVE_DATABASE__PORT=5432
ARMSERVE_DATABASE__USER=armserve

# Sensitive database password (masked via SecretStr)
ARMSERVE_DATABASE__PASSWORD=

ARMSERVE_DATABASE__NAME=armserve_dev
ARMSERVE_DATABASE__MAX_CONNECTIONS=20

# Optional explicit connection URI override (e.g. postgresql+asyncpg://...)
ARMSERVE_DATABASE__DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Cloud Provider Credentials (AWS / Azure / GCP)
# ------------------------------------------------------------------------------
# AWS Graviton settings
ARMSERVE_CLOUD__AWS_REGION=us-east-1

# Sensitive AWS credentials (masked via SecretStr)
# Leave empty if using IAM Roles for Service Accounts (IRSA) / EC2 instance profiles
ARMSERVE_CLOUD__AWS_ACCESS_KEY_ID=
ARMSERVE_CLOUD__AWS_SECRET_ACCESS_KEY=
ARMSERVE_CLOUD__AWS_S3_BUCKET=armserve-models

# Azure Cobalt 100 settings
ARMSERVE_CLOUD__AZURE_SUBSCRIPTION_ID=
ARMSERVE_CLOUD__AZURE_TENANT_ID=

# GCP Axion settings
ARMSERVE_CLOUD__GCP_PROJECT_ID=
ARMSERVE_CLOUD__GCP_CREDENTIALS_JSON=

# ------------------------------------------------------------------------------
# 4. Model & Artifact Storage Configuration
# ------------------------------------------------------------------------------
ARMSERVE_MODEL__DEFAULT_STORAGE_BUCKET=armserve-models
ARMSERVE_MODEL__MAX_MODEL_SIZE_BYTES=53687091200

# ------------------------------------------------------------------------------
# 5. Inference Runtime Configuration
# ------------------------------------------------------------------------------
ARMSERVE_INFERENCE__DEFAULT_RUNTIME=onnxruntime
ARMSERVE_INFERENCE__MAX_NUM_THREADS=64
ARMSERVE_INFERENCE__MAX_BATCH_SIZE=128
ARMSERVE_INFERENCE__MEMORY_LIMIT_MB_DEFAULT=4096

# ------------------------------------------------------------------------------
# 6. Optimization Controller & Agent Configuration
# ------------------------------------------------------------------------------
ARMSERVE_OPTIMIZATION__DEFAULT_STRATEGY=tpe
ARMSERVE_OPTIMIZATION__MAX_TRIALS_LIMIT=100
ARMSERVE_OPTIMIZATION__DEFAULT_TIMEOUT_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. Observability & Telemetry
# ------------------------------------------------------------------------------
ARMSERVE_OBSERVABILITY__OTLP_ENDPOINT=
ARMSERVE_OBSERVABILITY__PROMETHEUS_ENABLED=true
ARMSERVE_OBSERVABILITY__ENABLE_TRACING=false

# ------------------------------------------------------------------------------
# 8. Authentication & Security
# ------------------------------------------------------------------------------
# Master secret key for JWT signing (minimum 32 characters, MUST be non-default in production)
ARMSERVE_AUTH__SECRET_KEY=

ARMSERVE_AUTH__JWT_ALGORITHM=HS256
ARMSERVE_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60
ARMSERVE_AUTH__API_KEY_HEADER_NAME=X-API-Key
